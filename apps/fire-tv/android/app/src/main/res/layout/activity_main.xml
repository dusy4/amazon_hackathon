<?xml version="1.0" encoding="utf-8"?>
<!-- 10-foot UI: everything sits inside the 90% safe zone (48dp x 27dp margins on a 960x540dp TV canvas). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_timeout="2500"
        app:auto_show="false"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <!-- Active reference: what "that", "it" and "his" currently mean -->
    <LinearLayout
        android:id="@+id/moment_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="48dp"
        android:layout_marginTop="27dp"
        android:background="@drawable/pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="16dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_orange" />

        <TextView
            android:id="@+id/moment_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/tv_white"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="27dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/pill_bg"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/tv_gray"
        android:textSize="14sp" />

    <!-- Assistant panel: what you asked, the answer, and how it was done -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:maxLines="2"
            android:textColor="@color/tv_gray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/speech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="3"
            android:textColor="@color/tv_white"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:maxLines="5"
            android:textColor="@color/tv_gray"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:textColor="@color/amazon_orange"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Thinking indicator along the bottom edge -->
    <View
        android:id="@+id/thinking"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_gravity="bottom"
        android:background="@drawable/thinking_bar"
        android:visibility="invisible" />
</FrameLayout>
