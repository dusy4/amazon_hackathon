# Semantic Playback — copy to .env and fill in what you have. Everything is optional:
# without AWS credentials the stack runs fully locally with the documented fallbacks.

PORT=8787
# Public base URL that phones / the Fire TV emulator can reach (used for QR codes + deep links)
# PUBLIC_BASE_URL=http://192.168.1.20:8787

# --- AWS (enables the Amazon-native adapters) ---
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# Agent interpreter: "rules" (deterministic, default) or "bedrock" (Bedrock Converse tool-use
# for utterances the deterministic parser cannot handle)
# SP_AGENT=bedrock
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Embeddings used by `npm run ingest`: "local" (hashing embedder, default) or "nova"
# SP_EMBEDDINGS=nova
# NOVA_EMBED_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0

# Viewing Memory store: "file" (default, data/memory/events.jsonl) or "dynamodb"
# SP_MEMORY=dynamodb
# VIEWING_MEMORY_TABLE=semantic-playback-viewing-memory
