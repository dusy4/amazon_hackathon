# Semantic Playback — copy to .env and fill in what you have. Everything is optional:
# without AWS credentials the stack runs fully locally with the documented fallbacks.

PORT=8787
# Public base URL that phones / the Fire TV emulator can reach (used for QR codes + deep links)
# PUBLIC_BASE_URL=http://192.168.1.20:8787

# --- AWS (enables the Amazon-native adapters) ---
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# Agent interpreter. With SP_LLM set, an LLM agent interprets every utterance and calls the MCP tools;
# the rules parser only runs unambiguous transport controls ("pause", "half speed") and is the fallback
# when the model is unavailable. Without SP_LLM, the rules parser handles everything it can.
#   SP_LLM=bedrock     → Bedrock Converse (BEDROCK_MODEL_ID)
#   SP_LLM=openrouter  → OpenRouter (OPENROUTER_API_KEY, OPENROUTER_MODELS = comma-separated fallback list)
# SP_LLM=bedrock
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free

# Second-stage rerank of moment search: Cohere Rerank 3.5 on Bedrock (the reranker offered in us-east-1)
# SP_RERANK=bedrock

# Embeddings used by `npm run ingest`: "local" (hashing embedder, default) or "nova"
# SP_EMBEDDINGS=nova
# NOVA_EMBED_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0

# Viewing Memory store: "file" (default, data/memory/events.jsonl) or "dynamodb"
# SP_MEMORY=dynamodb
# VIEWING_MEMORY_TABLE=semantic-playback-viewing-memory
# SP_AGENTCORE_MEMORY_ID=<Amazon Bedrock AgentCore Memory id>
