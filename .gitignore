# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
coverage/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local tooling
.tmp/
.cache/
artifacts/

# Generated data (regenerate with npm run media:generate && npm run ingest)
data/clips/
data/memory/
data/content/*/*.mp4
# Compact 480p copies of the six titles ship with the repo so a fresh clone plays without any download step
# (full-quality originals: scripts/fetch-videos.sh, kept locally as *.hq.mp4).
!data/content/*/video.mp4
!data/content/harbor-v-northgate/match.mp4
!data/content/keepers-key/story.mp4
data/content/*/analysis/proxy.mp4

# Local-only test titles (third-party copyrighted media): never committed
data/content/local-*/
data/index/local-*
