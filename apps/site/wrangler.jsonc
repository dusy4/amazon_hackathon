{
  // semanticplayback.com: static site on Workers Static Assets. The Worker only runs for /media/* (HTTP Range for video).
  "name": "semantic-playback-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/media/*"]
  },
  "routes": [
    { "pattern": "semanticplayback.com", "custom_domain": true },
    { "pattern": "www.semanticplayback.com", "custom_domain": true }
  ]
}
